root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Dart enforces its own style through `dart format` (two spaces).
[*.{dart,yaml,yml,arb,json}]
indent_style = space
indent_size = 2

[*.{kts,gradle,xml,kt,java}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
